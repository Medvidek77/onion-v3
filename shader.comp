void fe_add(out fe h, in fe f, in fe g) {
    h.v0 = f.v0 + g.v0; h.v1 = f.v1 + g.v1; h.v2 = f.v2 + g.v2; h.v3 = f.v3 + g.v3; h.v4 = f.v4 + g.v4;
    h.v5 = f.v5 + g.v5; h.v6 = f.v6 + g.v6; h.v7 = f.v7 + g.v7; h.v8 = f.v8 + g.v8; h.v9 = f.v9 + g.v9;
}

void fe_sub(out fe h, in fe f, in fe g) {
    h.v0 = f.v0 - g.v0; h.v1 = f.v1 - g.v1; h.v2 = f.v2 - g.v2; h.v3 = f.v3 - g.v3; h.v4 = f.v4 - g.v4;
    h.v5 = f.v5 - g.v5; h.v6 = f.v6 - g.v6; h.v7 = f.v7 - g.v7; h.v8 = f.v8 - g.v8; h.v9 = f.v9 - g.v9;
}

void fe_mul(out fe h, in fe f, in fe g) {
    int f0=f.v0,f1=f.v1,f2=f.v2,f3=f.v3,f4=f.v4,f5=f.v5,f6=f.v6,f7=f.v7,f8=f.v8,f9=f.v9;
    int g0=g.v0,g1=g.v1,g2=g.v2,g3=g.v3,g4=g.v4,g5=g.v5,g6=g.v6,g7=g.v7,g8=g.v8,g9=g.v9;
    int g1_19=g1*19, g2_19=g2*19, g3_19=g3*19, g4_19=g4*19, g5_19=g5*19;
    int g6_19=g6*19, g7_19=g7*19, g8_19=g8*19, g9_19=g9*19;
    int f1_2=f1*2, f3_2=f3*2, f5_2=f5*2, f7_2=f7*2, f9_2=f9*2;

    int64_t h0 = int64_t(f0)*g0 + int64_t(f1_2)*g9_19 + int64_t(f2)*g8_19 + int64_t(f3_2)*g7_19 + int64_t(f4)*g6_19 
               + int64_t(f5_2)*g5_19 + int64_t(f6)*g4_19 + int64_t(f7_2)*g3_19 + int64_t(f8)*g2_19 + int64_t(f9_2)*g1_19;
    int64_t h1 = int64_t(f0)*g1 + int64_t(f1)*g0 + int64_t(f2)*g9_19 + int64_t(f3)*g8_19 + int64_t(f4)*g7_19 
               + int64_t(f5)*g6_19 + int64_t(f6)*g5_19 + int64_t(f7)*g4_19 + int64_t(f8)*g3_19 + int64_t(f9)*g2_19;
    int64_t h2 = int64_t(f0)*g2 + int64_t(f1_2)*g1 + int64_t(f2)*g0 + int64_t(f3_2)*g9_19 + int64_t(f4)*g8_19 
               + int64_t(f5_2)*g7_19 + int64_t(f6)*g6_19 + int64_t(f7_2)*g5_19 + int64_t(f8)*g4_19 + int64_t(f9_2)*g3_19;
    int64_t h3 = int64_t(f0)*g3 + int64_t(f1)*g2 + int64_t(f2)*g1 + int64_t(f3)*g0 + int64_t(f4)*g9_19 
               + int64_t(f5)*g8_19 + int64_t(f6)*g7_19 + int64_t(f7)*g6_19 + int64_t(f8)*g5_19 + int64_t(f9)*g4_19;
    int64_t h4 = int64_t(f0)*g4 + int64_t(f1_2)*g3 + int64_t(f2)*g2 + int64_t(f3_2)*g1 + int64_t(f4)*g0 
               + int64_t(f5_2)*g9_19 + int64_t(f6)*g8_19 + int64_t(f7_2)*g7_19 + int64_t(f8)*g6_19 + int64_t(f9_2)*g5_19;
    int64_t h5 = int64_t(f0)*g5 + int64_t(f1)*g4 + int64_t(f2)*g3 + int64_t(f3)*g2 + int64_t(f4)*g1 
               + int64_t(f5)*g0 + int64_t(f6)*g9_19 + int64_t(f7)*g8_19 + int64_t(f8)*g7_19 + int64_t(f9)*g6_19;
    int64_t h6 = int64_t(f0)*g6 + int64_t(f1_2)*g5 + int64_t(f2)*g4 + int64_t(f3_2)*g3 + int64_t(f4)*g2 
               + int64_t(f5_2)*g1 + int64_t(f6)*g0 + int64_t(f7_2)*g9_19 + int64_t(f8)*g8_19 + int64_t(f9_2)*g7_19;
    int64_t h7 = int64_t(f0)*g7 + int64_t(f1)*g6 + int64_t(f2)*g5 + int64_t(f3)*g4 + int64_t(f4)*g3 
               + int64_t(f5)*g2 + int64_t(f6)*g1 + int64_t(f7)*g0 + int64_t(f8)*g9_19 + int64_t(f9)*g8_19;
    int64_t h8 = int64_t(f0)*g8 + int64_t(f1_2)*g7 + int64_t(f2)*g6 + int64_t(f3_2)*g5 + int64_t(f4)*g4 
               + int64_t(f5_2)*g3 + int64_t(f6)*g2 + int64_t(f7_2)*g1 + int64_t(f8)*g0 + int64_t(f9_2)*g9_19;
    int64_t h9 = int64_t(f0)*g9 + int64_t(f1)*g8 + int64_t(f2)*g7 + int64_t(f3)*g6 + int64_t(f4)*g5 
               + int64_t(f5)*g4 + int64_t(f6)*g3 + int64_t(f7)*g2 + int64_t(f8)*g1 + int64_t(f9)*g0;

    int c;
    c=int((h0+(int64_t(1)<<25))>>26);h1+=c;h0-=int64_t(c)<<26;
    c=int((h1+(int64_t(1)<<24))>>25);h2+=c;h1-=int64_t(c)<<25;
    c=int((h2+(int64_t(1)<<25))>>26);h3+=c;h2-=int64_t(c)<<26;
    c=int((h3+(int64_t(1)<<24))>>25);h4+=c;h3-=int64_t(c)<<25;
    c=int((h4+(int64_t(1)<<25))>>26);h5+=c;h4-=int64_t(c)<<26;
    c=int((h5+(int64_t(1)<<24))>>25);h6+=c;h5-=int64_t(c)<<25;
    c=int((h6+(int64_t(1)<<25))>>26);h7+=c;h6-=int64_t(c)<<26;
    c=int((h7+(int64_t(1)<<24))>>25);h8+=c;h7-=int64_t(c)<<25;
    c=int((h8+(int64_t(1)<<25))>>26);h9+=c;h8-=int64_t(c)<<26;
    c=int((h9+(int64_t(1)<<24))>>25);h0+=int64_t(c*19);h9-=int64_t(c)<<25;
    c=int((h0+(int64_t(1)<<25))>>26);h1+=c;h0-=int64_t(c)<<26;
    
    h.v0=int(h0);h.v1=int(h1);h.v2=int(h2);h.v3=int(h3);h.v4=int(h4);
    h.v5=int(h5);h.v6=int(h6);h.v7=int(h7);h.v8=int(h8);h.v9=int(h9);
}

void fe_sq(out fe h, in fe f){
    int f0=f.v0, f1=f.v1, f2=f.v2, f3=f.v3, f4=f.v4, f5=f.v5, f6=f.v6, f7=f.v7, f8=f.v8, f9=f.v9;
    int f0_2=f0*2, f1_2=f1*2, f2_2=f2*2, f3_2=f3*2, f4_2=f4*2, f5_2=f5*2, f6_2=f6*2, f7_2=f7*2, f8_2=f8*2, f9_2=f9*2;
    int f1_4=f1*4, f3_4=f3*4, f5_4=f5*4, f7_4=f7*4;
    int f5_19=f5*19, f6_19=f6*19, f7_19=f7*19, f8_19=f8*19, f9_19=f9*19;

    int64_t h0 = int64_t(f0)*f0 + int64_t(f1_4)*f9_19 + int64_t(f2_2)*f8_19 + int64_t(f3_4)*f7_19 + int64_t(f4_2)*f6_19 + int64_t(f5_2)*f5_19;
    int64_t h1 = int64_t(f0_2)*f1 + int64_t(f2_2)*f9_19 + int64_t(f3_2)*f8_19 + int64_t(f4_2)*f7_19 + int64_t(f5_2)*f6_19;
    int64_t h2 = int64_t(f0_2)*f2 + int64_t(f1_2)*f1 + int64_t(f3_4)*f9_19 + int64_t(f4_2)*f8_19 + int64_t(f5_4)*f7_19 + int64_t(f6)*f6_19;
    int64_t h3 = int64_t(f0_2)*f3 + int64_t(f1_2)*f2 + int64_t(f4_2)*f9_19 + int64_t(f5_2)*f8_19 + int64_t(f6_2)*f7_19;
    int64_t h4 = int64_t(f0_2)*f4 + int64_t(f1_4)*f3 + int64_t(f2)*f2 + int64_t(f5_4)*f9_19 + int64_t(f6_2)*f8_19 + int64_t(f7_2)*f7_19;
    int64_t h5 = int64_t(f0_2)*f5 + int64_t(f1_2)*f4 + int64_t(f2_2)*f3 + int64_t(f6_2)*f9_19 + int64_t(f7_2)*f8_19;
    int64_t h6 = int64_t(f0_2)*f6 + int64_t(f1_4)*f5 + int64_t(f2_2)*f4 + int64_t(f3_2)*f3 + int64_t(f7_4)*f9_19 + int64_t(f8)*f8_19;
    int64_t h7 = int64_t(f0_2)*f7 + int64_t(f1_2)*f6 + int64_t(f2_2)*f5 + int64_t(f3_2)*f4 + int64_t(f8_2)*f9_19;
    int64_t h8 = int64_t(f0_2)*f8 + int64_t(f1_4)*f7 + int64_t(f2_2)*f6 + int64_t(f3_4)*f5 + int64_t(f4)*f4 + int64_t(f9_2)*f9_19;
    int64_t h9 = int64_t(f0_2)*f9 + int64_t(f1_2)*f8 + int64_t(f2_2)*f7 + int64_t(f3_2)*f6 + int64_t(f4_2)*f5;

    int c;
    c=int((h0+(int64_t(1)<<25))>>26);h1+=c;h0-=int64_t(c)<<26;
    c=int((h1+(int64_t(1)<<24))>>25);h2+=c;h1-=int64_t(c)<<25;
    c=int((h2+(int64_t(1)<<25))>>26);h3+=c;h2-=int64_t(c)<<26;
    c=int((h3+(int64_t(1)<<24))>>25);h4+=c;h3-=int64_t(c)<<25;
    c=int((h4+(int64_t(1)<<25))>>26);h5+=c;h4-=int64_t(c)<<26;
    c=int((h5+(int64_t(1)<<24))>>25);h6+=c;h5-=int64_t(c)<<25;
    c=int((h6+(int64_t(1)<<25))>>26);h7+=c;h6-=int64_t(c)<<26;
    c=int((h7+(int64_t(1)<<24))>>25);h8+=c;h7-=int64_t(c)<<25;
    c=int((h8+(int64_t(1)<<25))>>26);h9+=c;h8-=int64_t(c)<<26;
    c=int((h9+(int64_t(1)<<24))>>25);h0+=int64_t(c*19);h9-=int64_t(c)<<25;
    c=int((h0+(int64_t(1)<<25))>>26);h1+=c;h0-=int64_t(c)<<26;
    
    h.v0=int(h0);h.v1=int(h1);h.v2=int(h2);h.v3=int(h3);h.v4=int(h4);
    h.v5=int(h5);h.v6=int(h6);h.v7=int(h7);h.v8=int(h8);h.v9=int(h9);
}

void ge_madd_precomp_YZ(out fe r_Y,out fe r_Z,
                        in fe q_YplusX,in fe q_YminusX,in fe q_Z,in fe q_T2d){
    fe t1, t2;
    fe s_base_YplusX_s = load_fe_array(s_base_YplusX);
    fe s_base_YminusX_s = load_fe_array(s_base_YminusX);
    fe s_base_Z2_s = load_fe_array(s_base_Z2);
    fe s_base_T_s = load_fe_array(s_base_T);

    fe_mul(t1, s_base_YplusX_s, q_YplusX);   
    fe_mul(t2, s_base_YminusX_s, q_YminusX); 
    fe_add(r_Y, t1, t2);              
    fe_mul(t1, q_T2d, s_base_T_s);           
    fe_mul(t2, s_base_Z2_s, q_Z);            
    fe_sub(r_Z, t2, t1);              
    fe_add(t2, t2, t1);               
    fe_mul(t1, r_Y, t2);              
    r_Y = t1;
    fe_mul(t1, t2, r_Z);              
    r_Z = t1;
}

void fe_invert(out fe out_fe,in fe z){
    fe t0,t1,t2;
    fe_sq(t0,z); fe_sq(t1,t0); fe_sq(t1,t1); fe_mul(t1,z,t1); fe_mul(t0,t0,t1);
    fe_sq(t2,t0); fe_mul(t1,t1,t2);
    fe_sq(t2,t1);fe_sq(t2,t2);fe_sq(t2,t2);fe_sq(t2,t2);fe_sq(t2,t2);
    fe_mul(t1,t2,t1);
    fe_sq(t2,t1); for(int i=1;i<10;++i) fe_sq(t2,t2); fe_mul(t2,t2,t1);
    fe_sq(out_fe,t2); for(int i=1;i<20;++i) fe_sq(out_fe,out_fe); fe_mul(t2,out_fe,t2);
    fe_sq(out_fe,t2); for(int i=1;i<10;++i) fe_sq(out_fe,out_fe); fe_mul(t1,out_fe,t1);
    fe_sq(t2,t1); for(int i=1;i<50;++i) fe_sq(t2,t2); fe_mul(t2,t2,t1);
    fe_sq(out_fe,t2); for(int i=1;i<100;++i)fe_sq(out_fe,out_fe); fe_mul(t2,out_fe,t2);
    fe_sq(out_fe,t2); for(int i=1;i<50;++i) fe_sq(out_fe,out_fe); fe_mul(t1,out_fe,t1);
    fe_sq(t1,t1); for(int i=1;i<5;++i)  fe_sq(t1,t1); fe_mul(out_fe,t1,t0);
}

bool check_prefix(in fe h) {
    int h0=h.v0,h1=h.v1,h2=h.v2,h3=h.v3,h4=h.v4,h5=h.v5,h6=h.v6,h7=h.v7,h8=h.v8,h9=h.v9;
    int c;
    
    c=(h0+(1<<25))>>26; h1+=c; h0-=c<<26;
    c=(h1+(1<<24))>>25; h2+=c; h1-=c<<25;
    c=(h2+(1<<25))>>26; h3+=c; h2-=c<<26;
    c=(h3+(1<<24))>>25; h4+=c; h3-=c<<25;
    c=(h4+(1<<25))>>26; h5+=c; h4-=c<<26;
    c=(h5+(1<<24))>>25; h6+=c; h5-=c<<25;
    c=(h6+(1<<25))>>26; h7+=c; h6-=c<<26;
    c=(h7+(1<<24))>>25; h8+=c; h7-=c<<25;
    c=(h8+(1<<25))>>26; h9+=c; h8-=c<<26;
    
    int q=(19*h9+(1<<24))>>25;
    q=(h0+q)>>26; q=(h1+q)>>25; q=(h2+q)>>26; q=(h3+q)>>25;
    q=(h4+q)>>26; q=(h5+q)>>25; q=(h6+q)>>26; q=(h7+q)>>25;
    q=(h8+q)>>26; q=(h9+q)>>25; h0+=19*q;
    
    uint b;
    c=h0>>26; h1+=c; h0-=c<<26; 
    
    if (pc.valid_bytes > 0) {
        b = uint(h0) & 0xFFu; if ((b & get_mask_byte(0)) != get_target_byte(0)) return false;
    }
    if (pc.valid_bytes > 1) {
        b = (uint(h0) >> 8) & 0xFFu; if ((b & get_mask_byte(1)) != get_target_byte(1)) return false;
    }
    if (pc.valid_bytes > 2) {
        b = (uint(h0) >> 16) & 0xFFu; if ((b & get_mask_byte(2)) != get_target_byte(2)) return false;
    }
    if (pc.valid_bytes <= 3) return true;

    c=h1>>25; h2+=c; h1-=c<<25;
    b = ((uint(h0) >> 24) | (uint(h1) << 2)) & 0xFFu; if ((b & get_mask_byte(3)) != get_target_byte(3)) return false;
    if (pc.valid_bytes > 4) {
        b = (uint(h1) >> 6) & 0xFFu; if ((b & get_mask_byte(4)) != get_target_byte(4)) return false;
    }
    if (pc.valid_bytes > 5) {
        b = (uint(h1) >> 14) & 0xFFu; if ((b & get_mask_byte(5)) != get_target_byte(5)) return false;
    }
    if (pc.valid_bytes <= 6) return true;

    c=h2>>26; h3+=c; h2-=c<<26; 
    b = ((uint(h1) >> 22) | (uint(h2) << 3)) & 0xFFu; if ((b & get_mask_byte(6)) != get_target_byte(6)) return false;
    if (pc.valid_bytes > 7) {
        b = (uint(h2) >> 5) & 0xFFu; if ((b & get_mask_byte(7)) != get_target_byte(7)) return false;
    }
    if (pc.valid_bytes > 8) {
        b = (uint(h2) >> 13) & 0xFFu; if ((b & get_mask_byte(8)) != get_target_byte(8)) return false;
    }
    if (pc.valid_bytes <= 9) return true;

    c=h3>>25; h4+=c; h3-=c<<25;
    b = ((uint(h2) >> 21) | (uint(h3) << 5)) & 0xFFu; if ((b & get_mask_byte(9)) != get_target_byte(9)) return false;
    if (pc.valid_bytes > 10) {
        b = (uint(h3) >> 3) & 0xFFu; if ((b & get_mask_byte(10)) != get_target_byte(10)) return false;
    }
    if (pc.valid_bytes > 11) {
        b = (uint(h3) >> 11) & 0xFFu; if ((b & get_mask_byte(11)) != get_target_byte(11)) return false;
    }
    if (pc.valid_bytes <= 12) return true;

    c=h4>>26; h5+=c; h4-=c<<26;
    b = ((uint(h3) >> 19) | (uint(h4) << 6)) & 0xFFu; if ((b & get_mask_byte(12)) != get_target_byte(12)) return false;
    if (pc.valid_bytes > 13) {
        b = (uint(h4) >> 2) & 0xFFu; if ((b & get_mask_byte(13)) != get_target_byte(13)) return false;
    }
    if (pc.valid_bytes > 14) {
        b = (uint(h4) >> 10) & 0xFFu; if ((b & get_mask_byte(14)) != get_target_byte(14)) return false;
    }
    if (pc.valid_bytes > 15) {
        b = (uint(h4) >> 18) & 0xFFu; if ((b & get_mask_byte(15)) != get_target_byte(15)) return false;
    }
    return true;
}

#ifdef _PASS_1
void main() {
    uint id = gl_GlobalInvocationID.x;
    uint lid = gl_LocalInvocationID.x;

    if (lid == 0) {
        for(int i=0; i<10; i++) {
            s_base_YplusX[i] = base_point.YplusX[i];
            s_base_YminusX[i] = base_point.YminusX[i];
            s_base_Z2[i] = base_point.Z2[i];
            s_base_T[i] = base_point.T[i];
        }
    }
    barrier();

    fe R_Y, R_Z;

    if (id < pc.batch_size) {
        fe offset_YplusX = load_fe_array(offsets[id].YplusX);
        fe offset_YminusX = load_fe_array(offsets[id].YminusX);
        fe offset_Z = load_fe_array(offsets[id].Z);
        fe offset_T2d = load_fe_array(offsets[id].T2d);

        ge_madd_precomp_YZ(R_Y, R_Z,
                           offset_YplusX, offset_YminusX, offset_Z, offset_T2d);

        store_shared_P(lid, R_Z);
        store_shared_S(lid, R_Z);
    } else {
        fe one;
        one.v0=1; one.v1=0; one.v2=0; one.v3=0; one.v4=0;
        one.v5=0; one.v6=0; one.v7=0; one.v8=0; one.v9=0;
        store_shared_P(lid, one);
        store_shared_S(lid, one);
    }
    barrier();

    // Hillis-Steele LDS prefix scan
    for (uint stride = 1u; stride < WG_SIZE; stride *= 2u) {
        fe temp_P, temp_S;
        bool do_P = (lid >= stride);
        bool do_S = (lid + stride < WG_SIZE);

        if (do_P) {
            fe P_curr = load_shared_P(lid);
            fe P_prev = load_shared_P(lid - stride);
            fe_mul(temp_P, P_curr, P_prev);
        }
        
        if (do_S) {
            fe S_curr = load_shared_S(lid);
            fe S_next = load_shared_S(lid + stride);
            fe_mul(temp_S, S_curr, S_next);
        }
        
        barrier();

        if (do_P) store_shared_P(lid, temp_P);
        if (do_S) store_shared_S(lid, temp_S);
        
        barrier();
    }

    if (id < pc.batch_size) {
        fe P_excl;
        if (lid == 0u) {
            P_excl.v0=1; P_excl.v1=0; P_excl.v2=0; P_excl.v3=0; P_excl.v4=0;
            P_excl.v5=0; P_excl.v6=0; P_excl.v7=0; P_excl.v8=0; P_excl.v9=0;
        } else {
            P_excl = load_shared_P(lid - 1u);
        }

        fe S_excl;
        if (lid == WG_SIZE - 1u) {
            S_excl.v0=1; S_excl.v1=0; S_excl.v2=0; S_excl.v3=0; S_excl.v4=0;
            S_excl.v5=0; S_excl.v6=0; S_excl.v7=0; S_excl.v8=0; S_excl.v9=0;
        } else {
            S_excl = load_shared_S(lid + 1u);
        }

        // Store intermediate results to VRAM
        store_R_Y(id * 10u, R_Y);
        store_P_excl(id * 10u, P_excl);
        store_S_excl(id * 10u, S_excl);
    }

    if (lid == WG_SIZE - 1u) {
        uint group_id = gl_WorkGroupID.x;
        fe last_P = load_shared_P(WG_SIZE - 1u);
        store_workgroup_totals(group_id * 10u, last_P);
    }
}
