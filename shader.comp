layout(push_constant) uniform PushConstants {
    uint batch_size;
    uint valid_bytes;
    uint wg_size;
    uint byte_target[4];
    uint byte_mask[4];
} pc;

uint get_target_byte(uint idx) {
    return (pc.byte_target[idx / 4u] >> ((idx % 4u) * 8u)) & 0xFFu;
}

uint get_mask_byte(uint idx) {
    return (pc.byte_mask[idx / 4u] >> ((idx % 4u) * 8u)) & 0xFFu;
}

