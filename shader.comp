    fe f;
    f.v0 = arr[0]; f.v1 = arr[1]; f.v2 = arr[2]; f.v3 = arr[3]; f.v4 = arr[4];
    f.v5 = arr[5]; f.v6 = arr[6]; f.v7 = arr[7]; f.v8 = arr[8]; f.v9 = arr[9];
    return f;
}

