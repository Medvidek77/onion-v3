struct ge_precomp_base { int YplusX[10]; int YminusX[10]; int Z2[10]; int T[10]; };
struct ge_cached       { int YplusX[10]; int YminusX[10]; int Z[10];  int T2d[10]; };

layout(std430,set=0,binding=0) readonly buffer restrict BasePoint    { ge_precomp_base base_point; };
layout(std430,set=0,binding=1) readonly buffer restrict OffsetPoints { ge_cached offsets[]; };
